<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/panelRoot" android:orientation="vertical" android:padding="12dp" android:background="@drawable/panel_bg" android:layout_width="296dp" android:layout_height="wrap_content">
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:id="@+id/panelIcon" android:src="@drawable/ic_crown" android:contentDescription="OpenCheps" android:layout_width="26dp" android:layout_height="26dp" />
        <LinearLayout android:orientation="vertical" android:paddingStart="9dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:id="@+id/panelTitle" android:text="OPEN CHEPS" android:textColor="#EAF2FF" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.08" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/panelStatus" android:text="Подключаюсь…" android:textColor="#91A9C8" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
        <ImageButton android:id="@+id/panelRecal" android:src="@drawable/ic_refresh" android:background="@drawable/panel_btn_alt" android:contentDescription="Новая партия" android:padding="8dp" android:layout_marginStart="4dp" android:layout_width="34dp" android:layout_height="34dp" />
        <ImageButton android:id="@+id/panelToggle" android:src="@drawable/ic_pause" android:background="@drawable/panel_btn" android:contentDescription="Пауза" android:padding="8dp" android:layout_marginStart="4dp" android:layout_width="34dp" android:layout_height="34dp" />
        <ImageButton android:id="@+id/panelStop" android:src="@drawable/ic_close" android:background="@drawable/panel_btn_stop" android:contentDescription="Остановить" android:padding="8dp" android:layout_marginStart="4dp" android:layout_width="34dp" android:layout_height="34dp" />
    </LinearLayout>
    <TextView android:id="@+id/panelEval" android:text="Жду начальную позицию" android:textColor="#B9F66E" android:textStyle="bold" android:textSize="21sp" android:fontFamily="sans-serif-medium" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="32dp">
        <TextView android:id="@+id/sideWhite" android:text="БЕЛЫЕ" android:textSize="10sp" android:textStyle="bold" android:textColor="#101925" android:gravity="center" android:background="@drawable/pill_white" android:layout_marginEnd="6dp" android:layout_width="76dp" android:layout_height="match_parent" />
        <TextView android:id="@+id/sideBlack" android:text="ЧЁРНЫЕ" android:textSize="10sp" android:textStyle="bold" android:textColor="#101925" android:gravity="center" android:background="@drawable/pill_unselected" android:layout_marginEnd="6dp" android:layout_width="76dp" android:layout_height="match_parent" />
        <TextView android:text="▣ ДОСКА" android:gravity="end|center_vertical" android:textColor="#67D7FF" android:textSize="10sp" android:letterSpacing="0.05" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:id="@+id/panelBoard" android:clickable="true" android:focusable="true" android:contentDescription="Выбрать область шахматной доски" />
    </LinearLayout>
</LinearLayout>